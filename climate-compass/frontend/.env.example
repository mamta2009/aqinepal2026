# =============================================================================
# frontend/.env.example — copy to .env.local (dev) or .env.production (server build).
# NEXT_PUBLIC_* and BACKEND_PROXY_TARGET are applied at `yarn build` time.
# =============================================================================

# Canonical public site URL (sitemap/robots/metadata).
# Local:
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Production build on server:
# NEXT_PUBLIC_SITE_URL=https://ews.intelladapt.ai

# Leave unset so the browser calls same-origin /api (Next rewrites to FastAPI).
# NEXT_PUBLIC_API_BASE=

# Where Next proxies /api during `next build` / `next start`:
# Local:
# BACKEND_PROXY_TARGET=http://localhost:8000
# Production (API on same machine, Docker publish port):
# BACKEND_PROXY_TARGET=http://127.0.0.1:8010
