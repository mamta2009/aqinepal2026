# Base URL of the Climate Compass FastAPI backend (early-warning-system/).
# EXPO_PUBLIC_* vars are inlined at build time and are safe to be public
# (this is just the API origin, not a secret).
#
# Use http://127.0.0.1:8000 for local/dev. On Android emulators the app
# automatically rewrites 127.0.0.1 / localhost to 10.0.2.2 (host loopback).
#
# - iOS simulator / web: http://127.0.0.1:8000
# - Android emulator: same .env value (auto-mapped to http://10.0.2.2:8000)
# - Physical device: http://<your-computer-LAN-IP>:8000
# - Production: https://<your-render-service>.onrender.com
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
