{
  "cli": {
    "appVersionSource": "local",
    "requireCommit": false
  },
  "build": {
    "preview": {
      "channel": "preview",
      "distribution": "internal",
      "environment": "preview",
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview2": {
      "android": {
        "gradleCommand": ":app:assembleRelease"
      },
      "channel": "preview2",
      "environment": "preview"
    },
    "preview3": {
      "developmentClient": true,
      "channel": "preview3",
      "environment": "development"
    },
    "preview4": {
      "distribution": "internal",
      "channel": "preview4",
      "environment": "preview"
    },
    "production": {
      "channel": "production",
      "environment": "production",
      "ios": {
        "autoIncrement": true
      },
      "android": {
        "buildType": "app-bundle",
        "autoIncrement": false
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "language": "en-US",
        "companyName": "Edwise Tech Inc."
      }
    }
  }
}
