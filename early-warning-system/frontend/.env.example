# =============================================================================
# frontend/.env.example — copy to .env.local for local `next dev` only.
# Production UI is a static export served by FastAPI (same origin as /api).
# =============================================================================

# Canonical public site URL (used for sitemap/robots/metadata at build time).
# Local with FastAPI serving static export:
#   NEXT_PUBLIC_SITE_URL=http://127.0.0.1:8000
# Or when using `next dev` on port 3000:
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Leave unset for local/dev so the browser uses same-origin /api
# (`next.config.ts` rewrites /api → FastAPI during `next dev`).
# NEXT_PUBLIC_API_BASE=

# Optional rewrite target when FastAPI is not on localhost:8000:
# BACKEND_PROXY_TARGET=http://localhost:8000
