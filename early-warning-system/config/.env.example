# FastAPI Configuration
# Also see ../backend/.env.example for backend-first template (notifications, Twilio webhooks, automation).
ENVIRONMENT=production
DEBUG=False

# Database — local dev (MongoDB Atlas in prod)
MONGODB_URL=mongodb://127.0.0.1:27017/early_warning

# Atlas production example:
# MONGODB_URL=mongodb+srv://USER:PASS@CLUSTER.mongodb.net/early_warning?retryWrites=true&w=majority

# APIs
IQAIR_API_KEY=your_iqair_key
# OpenWeatherMap (direct) — GET /api/weather/openweather/current and /api/weather/openweather/air-pollution
# https://openweathermap.org/api — Current Weather 2.5 + Air Pollution 2.5. Optional OPENWEATHERMAP_API_BASE_URL to override base.
# Air pollution route is cross-check only; headline AQ uses WeatherAPI.com first when WEATHERAPI_COM_API_KEY is set.
OPENWEATHER_API_KEY=your_openweather_key

# WAQI (World Air Quality Index) — used after direct WeatherAPI when resolving air quality; then RapidAPI
# https://aqicn.org/api/ — token as query param; use geo feed from server, not feed/here/
WAQI_TOKEN=

# OpenRouter (LLM) — proxied via POST /api/ai/openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# Optional headers OpenRouter recommends for rankings
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=Climate Compass

# Meteostat (RapidAPI) — GET /api/weather/meteostat/monthly
RAPIDAPI_METEOSTAT_HOST=meteostat.p.rapidapi.com
RAPIDAPI_METEOSTAT_PATH=/point/monthly

# RapidAPI weather — host/path/query mode must match the product you subscribed to on RapidAPI.
#
# Option A — WeatherAPI-com proxy (lat/lon):
#   RAPIDAPI_WEATHER_HOST=weatherapi-com.p.rapidapi.com
#   RAPIDAPI_WEATHER_PATH=/current.json
#   RAPIDAPI_WEATHER_QUERY_MODE=q
#
# Option B — "Weather API - By Any City" (city name in URL path):
#   RAPIDAPI_WEATHER_HOST=weather-api-by-any-city.p.rapidapi.com
#   RAPIDAPI_WEATHER_PATH=/weather
#   RAPIDAPI_WEATHER_QUERY_MODE=city
# Dashboard must call endpoints with ?city=... ; lat/lon-only requests skip WAQI label and city-path Rapid fails fast.
#
# Common WeatherAPI curl (Meteostat / current) examples are commented in older docs.
RAPIDAPI_WEATHER_API_KEY=
RAPIDAPI_WEATHER_HOST=weatherapi-com.p.rapidapi.com
RAPIDAPI_WEATHER_PATH=/current.json
# Query style: q (default; WeatherAPI-com), latlon (?lat=&lon=), or city (?path=/weather + /London)
RAPIDAPI_WEATHER_QUERY_MODE=q

# Include air_quality in WeatherAPI-com /current.json responses (ignored for QUERY_MODE=city).
# Set to false only if your upstream rejects unknown params.
RAPIDAPI_WEATHER_AQI=yes

# WeatherAPI.com direct (paid) — tried FIRST for /api/air-quality/current when set; also preferred for GET /api/weather/current
# Alternate env name supported: WEATHERAPI_API_KEY
WEATHERAPI_COM_API_KEY=

# Concurrent WeatherAPI-com /current calls (air-quality fallback + /api/weather/current). Lower if you see rapid_http_429.
RAPIDAPI_CONCURRENCY_LIMIT=2

# Open Weather 13 (RapidAPI) — GET /api/weather/open-weather13/fiveday
# Upstream: GET https://open-weather13.p.rapidapi.com/fivedaysforcast?latitude=...&longitude=...&lang=EN
RAPIDAPI_OPENWEATHER13_HOST=open-weather13.p.rapidapi.com
RAPIDAPI_OPENWEATHER13_PATH=/fivedaysforcast
# Leave empty to use the same key as RAPIDAPI_WEATHER_API_KEY:
RAPIDAPI_OPENWEATHER13_API_KEY=

# Server-side cache for successful GET /api/air-quality/current per rounded lat/lon (seconds). 0 disables.
AIR_QUALITY_COORD_CACHE_SECONDS=120

# Alternate env key name supported in code:
# RapidAPI_Weather_API_Key=

# Blockchain (Polygon)
BLOCKCHAIN_ENABLED=true
BLOCKCHAIN_NETWORK=polygon-mainnet
POLYGON_RPC_URL=https://polygon-rpc.com
# Optional Mumbai/Amoy testnet RPC if you deploy contracts there first
POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology

POLYGON_PRIVATE_KEY=your_private_key_without_0x

# Twilio (SMS Alerts)
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Health Data
DHIS2_USERNAME=your_dhis2_username
DHIS2_PASSWORD=your_dhis2_password
DHIS2_URL=https://dhis2.health.gov.np

# Deployment (surfaced by API payloads, e.g. /api/cases/all-cities)
DEPLOYMENT_MODE=REGIONAL
PORT=8000

# Frontend / reverse-proxy (optional)
# If dashboard is hosted elsewhere but API stays here, set e.g. https://api.myapp.com
PUBLIC_API_ORIGIN=
API_PATH_PREFIX=/api
