# =============================================================================
# backend/.env.example — copy to .env and replace placeholders.
# Load order: backend/.env first, then ../config/.env (only fills vars not already set).
# Do not commit .env. See also ../config/.env.example for additional integration keys.
# Documentation: ../docs/guides/IMPLEMENTATION_SNAPSHOT.md — Notifications & Runtime sections.
# =============================================================================

# --- Server ---
ENVIRONMENT=development
DEBUG=True
PORT=8000
DEPLOYMENT_MODE=REGIONAL

# FastAPI serves /api/* and (when built) the Next.js static export for /.
# Build UI: cd frontend && npm run build  →  frontend/out
# Optional override for the export directory:
# FRONTEND_OUT_DIR=/absolute/path/to/frontend/out
#
# Local (single host): http://127.0.0.1:8000
# Production: one host for UI+API, or keep a dedicated API host if you prefer.
#
# Optional: public API origin advertised in /api/runtime-config (no trailing slash).
PUBLIC_API_ORIGIN=
# Optional: public site origin advertised in /api/system-discovery (no trailing slash).
PUBLIC_FRONTEND_ORIGIN=http://127.0.0.1:8000
API_PATH_PREFIX=/api
# Browser CORS allowlist (comma-separated origins, no paths). Never use `*` with credentials.
# Same-origin static UI does not need CORS. Keep localhost:3000 when using `next dev`.
# If omitted in development, localhost 3000/5173 plus Capacitor/Ionic schemes are allowed.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# GET /api/environment/overview calls the existing AQ/heat resolvers with bounded concurrency.
ENVIRONMENT_OVERVIEW_CONCURRENCY=2
ENVIRONMENT_OVERVIEW_TIMEOUT_SECONDS=35

# --- MongoDB ---
# URI lookup (first match wins): MONGODB_URL → MONGODB_URI → DATABASE_URL — but DATABASE_URL must be
# literally mongodb:// or mongodb+srv:// (Render often sets DATABASE_URL to Postgres instead).
# Strip quotes/BOM OK. Placeholder URIs containing username:password@ or your_… are skipped.
#
# Logical DB name when the URI has no /dbname path (common Atlas wizard output):
# Set MONGODB_DB_NAME / MONGO_DB_NAME / MONGODB_DATABASE / MONGODB_DEFAULT_DB / DB_NAME
# ("DATABASE_NAME" is not applied to MongoDB — avoids clashing with Render Postgres addons.)
#
# Local: mongodb://127.0.0.1:27017/early_warning
# Atlas: mongodb+srv://USER:PASS@CLUSTER.mongodb.net/early_warning?retryWrites=true&w=majority
MONGODB_URL=mongodb://127.0.0.1:27017/early_warning
# MONGODB_URI=
# DATABASE_URL=mongodb+srv://...           # OK only if Postgres is not occupying this slot
# MONGODB_DB_NAME=early_warning
# MONGO_DB_NAME=

# --- OpenRouter (LLM) — POST /api/ai/openrouter ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=Climate Compass

# aqiHelp (POST /api/help/aqi/chat; UI page lives on Next at /help/aqi-help) — uses OPENROUTER_API_KEY.
# AQI_HELP_MODEL=openai/gpt-4o-mini

# --- RapidAPI -----------------------------------------------------------------
# X-RapidAPI-Key for WeatherAPI-com, Meteostat, Open Weather 13, etc. (subscribe per product).
RAPIDAPI_WEATHER_API_KEY=

# Alternate env name (supported in code)
# RapidAPI_Weather_API_Key=

RAPIDAPI_METEOSTAT_HOST=meteostat.p.rapidapi.com
RAPIDAPI_METEOSTAT_PATH=/point/monthly

RAPIDAPI_WEATHER_HOST=weatherapi-com.p.rapidapi.com
RAPIDAPI_WEATHER_PATH=/current.json
RAPIDAPI_WEATHER_QUERY_MODE=q
# Include air_quality in WeatherAPI-com /current.json (ignored for QUERY_MODE=city).
RAPIDAPI_WEATHER_AQI=yes

# Concurrent WeatherAPI-com calls (lower if you see rapid_http_429).
RAPIDAPI_CONCURRENCY_LIMIT=2

# WeatherAPI.com DIRECT (https://www.weatherapi.com/) — tried first for AQ when set.
# Alias: WEATHERAPI_API_KEY
WEATHERAPI_COM_API_KEY=

RAPIDAPI_OPENWEATHER13_HOST=open-weather13.p.rapidapi.com
RAPIDAPI_OPENWEATHER13_PATH=/fivedaysforcast
RAPIDAPI_OPENWEATHER13_API_KEY=

# WAQI (aqicn) — aliases: WAQI_API_TOKEN, WAQI_API_KEY
WAQI_TOKEN=

# --- Other APIs (optional) ---
IQAIR_API_KEY=

# --- OpenWeatherMap (optional) — /api/weather/openweather/*
OPENWEATHER_API_KEY=
# OPENWEATHERMAP_API_KEY is an accepted alias.

# Server-side cache for GET /api/air-quality/current per rounded lat/lon (seconds). 0 disables.
AIR_QUALITY_COORD_CACHE_SECONDS=120

# --- Persisted AQ snapshots (Mongo `air_quality_snapshots`) ---
# Enables APScheduler job + optional tabletop export alignment with bundled dashboard demos.
AQ_SNAPSHOT_SYNC_ENABLED=false
AQ_SNAPSHOT_SYNC_HOURS=6

# --- Polygon / blockchain ---
BLOCKCHAIN_ENABLED=true
BLOCKCHAIN_NETWORK=polygon-mainnet
POLYGON_RPC_URL=https://polygon-rpc.com
POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology
POLYGON_PRIVATE_KEY=

# Optional on-chain tx logging (uses gas when enabled). See docs/guides/IMPLEMENTATION_SNAPSHOT.md
# ("Polygon on-chain audit trail") and docs/guides/blockchain-ai/README.md.
# MongoDB collection onchain_anchor_log stores every anchor attempt (tx hash or skip reason) for operators
# (GET /api/admin/blockchain/anchors, Admin dashboard).
POLYGON_ONCHAIN_LOG=false
# Polygon PoS testnet: use amoy (Mumbai is retired). Matches POLYGON_AMOY_RPC_URL.
BLOCKCHAIN_ONCHAIN_NETWORK=amoy
POLYGON_MUMBAI_RPC_URL=https://rpc-mumbai.maticvigil.com

# --- DHIS2 (optional) ---
DHIS2_URL=
DHIS2_USERNAME=
DHIS2_PASSWORD=

# --- SendGrid (optional) — email verification & alerts ---
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
# Minimum seconds between POST /api/contacts/resend-verification for the same pending email
VERIFICATION_RESEND_COOLDOWN_SECONDS=60
# Sanity check SendGrid from the running API (Bearer NOTIFICATION_API_KEY):
# POST /api/notifications/resend/test {"to":"you@example.com"}
# Deep link used in alert emails/SMS (Next.js dashboard URL).
# Local: http://localhost:3000/dashboard
# Production: https://ews.intelladapt.com/dashboard
NOTIFICATION_DASHBOARD_URL=http://localhost:3000/dashboard

# User-initiated friend/family alerts (dashboard / GET/POST /api/auth/shared-contacts*)
# SHARED_ALERT_CONTACTS_MAX=50
# SHARED_ALERT_NOTIFY_DAILY_MAX=100

# --- Twilio (optional) — SMS / WhatsApp ---
# TWILIO_MESSAGE_CHANNEL=sms
# TWILIO_WHATSAPP_USE_SANDBOX — whatsapp sandbox From when ENVIRONMENT=development or sandbox
# TWILIO_WHATSAPP_SANDBOX=+14155238886
# TWILIO_ACCOUNT_SID=ACxxxxxxxx
# Prefer API Key (recommended) OR Auth Token — not required to set both:
# TWILIO_API_KEY_SID=SKxxxxxxxx
# TWILIO_API_KEY_SECRET=(secret shown once when key is created)
# TWILIO_AUTH_TOKEN=   # still used if API key vars omitted; REQUIRED for webhook signature check when TWILIO_WEBHOOK_VALIDATE=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_PHONE_NUMBER=

# --- Notifications: auth + webhooks + automation (optional) ---
# If set, protects: POST send/broadcast/evaluate, Twilio test, GET/P contacts, analytics.
# Use: Authorization: Bearer <NOTIFICATION_API_KEY> OR header X-API-Key
NOTIFICATION_API_KEY=

# Twilio signature validation for POST /api/webhooks/* (requires TWILIO_AUTH_TOKEN).
# Set TWILIO_WEBHOOK_PUBLIC_URL to the exact public URL Twilio calls if behind a proxy.
TWILIO_WEBHOOK_VALIDATE=
TWILIO_WEBHOOK_PUBLIC_URL=

# Dev only: exposes POST /api/contacts/dev/* wipe helpers for QA.
# Set false or omit in production — never expose a public server with this enabled.
ALLOW_DEV_REGISTRATION_DB_RESET=false

# Shared passphrase for GET /api/contacts/directory (Next page: /registration/contacts-directory).
# Send HTTP header: X-Registration-Directory-Secret: <same value>. Quote if it contains spaces.
# REGISTRATION_DIRECTORY_SECRET=

# Optional: PIN gate for admin console unlock (Next page: /admin). Falls back to
# REGISTRATION_DIRECTORY_SECRET, then server default "2026!".
# ADMIN_CONSOLE_PIN=
# After unlock, session is stored in MongoDB (operator_console_sessions) as HttpOnly
# cookie ew_admin_session on this host.
# ADMIN_CONSOLE_SESSION_HOURS=24
# ADMIN_SESSION_COOKIE_NAME=ew_admin_session
# Set true on HTTPS deploys so Secure is set even when proxies terminate TLS:
# ADMIN_SESSION_COOKIE_SECURE=true
# Registrant/facility web sessions use HttpOnly cc_registrant_token on this host.
# REGISTRANT_SESSION_COOKIE_NAME=cc_registrant_token

# Optional: when set, receive one email when someone signs in with correct password but verification is still pending
# (requires SendGrid or your send_email path). Also always logged to MongoDB action_logs as action_type=registrant_login_blocked_unverified.
# ADMIN_UNVERIFIED_LOGIN_ALERT_EMAIL=

# POST /api/alerts/evaluate — minimum minutes between evaluate-triggered broadcasts per city.
ALERT_EVAL_COOLDOWN_MINUTES=60

# Heat evaluate (POST /api/alerts/evaluate-heat) — tiers on °C snapshot max(ambient, feels-like).
HEAT_THRESHOLD_MODERATE_C=30
HEAT_THRESHOLD_HIGH_C=35
HEAT_THRESHOLD_SEVERE_C=40
# Omit to reuse ALERT_EVAL_COOLDOWN_MINUTES; separate window avoids cross-blocking air sends.
HEAT_EVAL_COOLDOWN_MINUTES=

# POST /api/health/cases/daily-report — optional surge broadcast vs rolling average respiratory_cases
DAILY_REPORT_NOTIFY_ENABLED=false
DAILY_SPIKE_CASE_MULTIPLIER=1.5
DAILY_SPIKE_MIN_PRIOR_REPORTS=3

# --- Facility reporting (JWT) ---
# AUTO_APPROVE_VERIFIED_CONTACTS=true → verifying email instantly approves alert + Facility Actions access.
# Set false when partners must PATCH /api/contacts/{contact_id}/approval (requires NOTIFICATION_API_KEY).
AUTO_APPROVE_VERIFIED_CONTACTS=true
# HS256 signing key for Bearer tokens exchanged after OTP. If unset, derives from NOTIFICATION_API_KEY (dev-only).
FACILITY_JWT_SECRET=
FACILITY_ACCESS_TOKEN_HOURS=168
FACILITY_LOGIN_CODE_TTL_MINUTES=15

# --- Registrant dashboard login (bcrypt + session JWT) ---
# If unset, derives from FACILITY_JWT_SECRET or NOTIFICATION_API_KEY (dev only).
REGISTRANT_JWT_SECRET=
REGISTRANT_SESSION_TOKEN_HOURS=336
# Optional periodic renewal: 0 disables. When due, login emails/SMS/WhatsApp a code; user must submit
# CURRENT password + that code + NEW password (8+) in one POST /api/auth/login to continue.
SESSION_REVERIFICATION_DAYS=90
SESSION_REVERIFICATION_CODE_TTL_MINUTES=30

# --- AI surge forecast (GET /api/models/surge-forecast/{city}) ---
# Polynomial degree for case-series extrapolation (1–3; capped by series length).
# AI_TREND_POLY_DEGREE=2
# Partner communication: replace with hold-out accuracy when real facility labels exist.
# AI_SURGE_DECLARED_ACCURACY_PERCENT=78
# Optional ISO8601 timestamp shown as last batch retrain (monthly policy is operational).
# AI_MODEL_LAST_TRAIN_AT=
