# =============================================================================
# backend/.env.example — copy to .env and replace placeholders.
# Load order: backend/.env first, then ../config/.env (only fills vars not already set).
# Do not commit .env. See also ../config/.env.example for additional integration keys.
# Documentation: ../docs/IMPLEMENTATION_SNAPSHOT.md — Notifications & Runtime sections.
# =============================================================================

# --- Server ---
ENVIRONMENT=development
DEBUG=True
PORT=8000
DEPLOYMENT_MODE=REGIONAL

# Optional: if the dashboard is on another origin
PUBLIC_API_ORIGIN=
API_PATH_PREFIX=/api

# --- MongoDB ---
# Primary: MONGODB_URL. Render / some bundles use DATABASE_URL — both are accepted.
# Local: mongodb://127.0.0.1:27017/early_warning
# Atlas: mongodb+srv://USER:PASS@CLUSTER.mongodb.net/early_warning?retryWrites=true&w=majority
MONGODB_URL=mongodb://127.0.0.1:27017/early_warning
# DATABASE_URL=   # Atlas / Render-compatible alias → same as MONGODB_URL when MONGODB_URL unset

# --- OpenRouter (LLM) — POST /api/ai/openrouter ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=Early Warning System

# --- RapidAPI -----------------------------------------------------------------
# X-RapidAPI-Key for WeatherAPI-com, Meteostat, Open Weather 13, etc. (subscribe per product).
RAPIDAPI_WEATHER_API_KEY=

# Alternate env name (supported in code)
# RapidAPI_Weather_API_Key=

RAPIDAPI_METEOSTAT_HOST=meteostat.p.rapidapi.com
RAPIDAPI_METEOSTAT_PATH=/point/monthly

RAPIDAPI_WEATHER_HOST=weatherapi-com.p.rapidapi.com
RAPIDAPI_WEATHER_PATH=/current.json
RAPIDAPI_WEATHER_QUERY_MODE=q
# Include air_quality in WeatherAPI-com /current.json (ignored for QUERY_MODE=city).
RAPIDAPI_WEATHER_AQI=yes

# Concurrent WeatherAPI-com calls (lower if you see rapid_http_429).
RAPIDAPI_CONCURRENCY_LIMIT=2

# WeatherAPI.com DIRECT (https://www.weatherapi.com/) — tried first for AQ when set.
# Alias: WEATHERAPI_API_KEY
WEATHERAPI_COM_API_KEY=

RAPIDAPI_OPENWEATHER13_HOST=open-weather13.p.rapidapi.com
RAPIDAPI_OPENWEATHER13_PATH=/fivedaysforcast
RAPIDAPI_OPENWEATHER13_API_KEY=

# WAQI (aqicn) — aliases: WAQI_API_TOKEN, WAQI_API_KEY
WAQI_TOKEN=

# --- Other APIs (optional) ---
IQAIR_API_KEY=

# --- OpenWeatherMap (optional) — /api/weather/openweather/*
OPENWEATHER_API_KEY=
# OPENWEATHERMAP_API_KEY is an accepted alias.

# Server-side cache for GET /api/air-quality/current per rounded lat/lon (seconds). 0 disables.
AIR_QUALITY_COORD_CACHE_SECONDS=120

# --- Persisted AQ snapshots (Mongo `air_quality_snapshots`) ---
# Enables APScheduler job + optional tabletop export alignment with bundled dashboard demos.
AQ_SNAPSHOT_SYNC_ENABLED=false
AQ_SNAPSHOT_SYNC_HOURS=6

# --- Polygon / blockchain ---
BLOCKCHAIN_ENABLED=true
BLOCKCHAIN_NETWORK=polygon-mainnet
POLYGON_RPC_URL=https://polygon-rpc.com
POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology
POLYGON_PRIVATE_KEY=

# Optional on-chain tx logging (uses gas when enabled)
POLYGON_ONCHAIN_LOG=false
# Polygon PoS testnet: use amoy (Mumbai is retired). Matches POLYGON_AMOY_RPC_URL.
BLOCKCHAIN_ONCHAIN_NETWORK=amoy
POLYGON_MUMBAI_RPC_URL=https://rpc-mumbai.maticvigil.com

# --- DHIS2 (optional) ---
DHIS2_URL=
DHIS2_USERNAME=
DHIS2_PASSWORD=

# --- Resend (optional) — email verification & alerts ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Minimum seconds between POST /api/contacts/resend-verification for the same pending email
VERIFICATION_RESEND_COOLDOWN_SECONDS=60
# Sanity check Resend from the running API (Bearer NOTIFICATION_API_KEY):
# POST /api/notifications/resend/test {"to":"you@verified-domain.com"}
NOTIFICATION_DASHBOARD_URL=

# --- Twilio (optional) — SMS / WhatsApp ---
# TWILIO_MESSAGE_CHANNEL=sms
# TWILIO_WHATSAPP_USE_SANDBOX — whatsapp sandbox From when ENVIRONMENT=development or sandbox
# TWILIO_WHATSAPP_SANDBOX=+14155238886
# TWILIO_ACCOUNT_SID=ACxxxxxxxx
# Prefer API Key (recommended) OR Auth Token — not required to set both:
# TWILIO_API_KEY_SID=SKxxxxxxxx
# TWILIO_API_KEY_SECRET=(secret shown once when key is created)
# TWILIO_AUTH_TOKEN=   # still used if API key vars omitted; REQUIRED for webhook signature check when TWILIO_WEBHOOK_VALIDATE=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_PHONE_NUMBER=

# --- Notifications: auth + webhooks + automation (optional) ---
# If set, protects: POST send/broadcast/evaluate, Twilio test, GET/P contacts, analytics.
# Use: Authorization: Bearer <NOTIFICATION_API_KEY> OR header X-API-Key
NOTIFICATION_API_KEY=

# Twilio signature validation for POST /api/webhooks/* (requires TWILIO_AUTH_TOKEN).
# Set TWILIO_WEBHOOK_PUBLIC_URL to the exact public URL Twilio calls if behind a proxy.
TWILIO_WEBHOOK_VALIDATE=
TWILIO_WEBHOOK_PUBLIC_URL=

# Dev only: exposes UI + API on /registration to wipe contacts + consent_records for QA.
# Set false or omit in production — never expose a public server with this enabled.
ALLOW_DEV_REGISTRATION_DB_RESET=false

# Shared passphrase for GET /api/contacts/directory and the /registration/contacts-directory page.
# Send HTTP header: X-Registration-Directory-Secret: <same value>. Quote if it contains spaces.
# REGISTRATION_DIRECTORY_SECRET=

# Optional: PIN gate for GET /admin/dashboard UI. Falls back to REGISTRATION_DIRECTORY_SECRET, then server default "2026!".
# ADMIN_CONSOLE_PIN=

# POST /api/alerts/evaluate — minimum minutes between evaluate-triggered broadcasts per city.
ALERT_EVAL_COOLDOWN_MINUTES=60

# Heat evaluate (POST /api/alerts/evaluate-heat) — tiers on °C snapshot max(ambient, feels-like).
HEAT_THRESHOLD_MODERATE_C=30
HEAT_THRESHOLD_HIGH_C=35
HEAT_THRESHOLD_SEVERE_C=40
# Omit to reuse ALERT_EVAL_COOLDOWN_MINUTES; separate window avoids cross-blocking air sends.
HEAT_EVAL_COOLDOWN_MINUTES=

# POST /api/health/cases/daily-report — optional surge broadcast vs rolling average respiratory_cases
DAILY_REPORT_NOTIFY_ENABLED=false
DAILY_SPIKE_CASE_MULTIPLIER=1.5
DAILY_SPIKE_MIN_PRIOR_REPORTS=3

# --- Facility reporting (JWT) ---
# AUTO_APPROVE_VERIFIED_CONTACTS=true → verifying email instantly approves alert + Facility Actions access.
# Set false when partners must PATCH /api/contacts/{contact_id}/approval (requires NOTIFICATION_API_KEY).
AUTO_APPROVE_VERIFIED_CONTACTS=true
# HS256 signing key for Bearer tokens exchanged after OTP. If unset, derives from NOTIFICATION_API_KEY (dev-only).
FACILITY_JWT_SECRET=
FACILITY_ACCESS_TOKEN_HOURS=168
FACILITY_LOGIN_CODE_TTL_MINUTES=15

# --- Registrant dashboard login (bcrypt + session JWT) ---
# If unset, derives from FACILITY_JWT_SECRET or NOTIFICATION_API_KEY (dev only).
REGISTRANT_JWT_SECRET=
REGISTRANT_SESSION_TOKEN_HOURS=336
